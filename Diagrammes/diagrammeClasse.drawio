        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\nabstract class Personne {\n    # nom : String\n    # prenom : String\n    # email : String\n    # motDePasse : String\n}\n\nclass Client {\n    - idClient : String\n    - comptes : HashMap&lt;String, Compte&gt;\n    + ajouterCompte(compte : Compte) : void\n    + consulterSolde(numeroCompte : String) : double\n}\n\nclass Gestionnaire {\n    - idGestionnaire : String\n}\n\nclass Compte {\n    - numeroCompte : String\n    - solde : double\n    - typeCompte : TypeCompte\n    - historiqueTransactions : HashSet&lt;Transaction&gt;\n    + deposer(montant : double) : void\n    + retirer(montant : double) : boolean\n    + virer(montant : double, destination : Compte) : boolean\n}\n\nenum TypeCompte {\n    COURANT\n    EPARGNE\n}\n\nclass Transaction {\n    - idTransaction : String\n    - type : TypeTransaction\n    - montant : double\n    - date : Date\n}\n\nenum TypeTransaction {\n    DEPOT\n    RETRAIT\n    VIREMENT\n}\n\n&#39; Relations de considération et d&#39;héritage\nPersonne &lt;|-- Client\nPersonne &lt;|-- Gestionnaire\n\nClient \&quot;1\&quot; -- \&quot;1..*\&quot; Compte : possède &gt;\nCompte \&quot;1\&quot; o-- \&quot;*\&quot; Transaction : contient &gt;\n\nTransaction \&quot;0..1\&quot; --&gt; \&quot;1\&quot; Compte : compteSource\nTransaction \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Compte : compteDestination\nCompte --&gt; TypeCompte : typeCompte\nTransaction --&gt; TypeTransaction : type\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="J7nTpDHSKgXUfWM88hEj-0">
